# Allow only files needed by the application images. No .env, docs or user data.
**
!backend/
!backend/pyproject.toml
!backend/uv.lock
!backend/alembic.ini
!backend/app/
!backend/app/**
!backend/alembic/
!backend/alembic/**
!backend/scripts/
!backend/scripts/**
!backend/tests/
!backend/tests/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!infra/
!infra/backend.Dockerfile
!infra/frontend.Dockerfile
!infra/nginx.conf
!infra/ci/
!infra/ci/**
**/__pycache__/
**/*.pyc
**/.env*
**/node_modules/
**/.venv/
**/.eval-cache/
**/.runtime/
**/model_cache/
**/storage/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
**/*.tsbuildinfo
