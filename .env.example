POSTGRES_USER=studyrag
POSTGRES_PASSWORD=studyrag_dev
POSTGRES_DB=studyrag
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://studyrag:studyrag_dev@localhost:5432/studyrag
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
AUTH_SECRET=replace-with-a-long-random-secret-before-deployment
DEMO_PASSWORD=study-demo-only
MAX_UPLOAD_MB=25
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=16
EMBEDDING_THREADS=2
INGESTION_PAIR_HEADINGS=false
INGESTION_PDF_LAYOUT=false
# Durable delivery and worker-owned recovery loop; no separate scheduler needed.
INGESTION_LEASE_SECONDS=180
INGESTION_RECOVERY_INTERVAL=15
INGESTION_DELIVERY_SECONDS=60
INGESTION_MAX_ATTEMPTS=3
INGESTION_MAX_DELIVERIES=20
MODEL_CACHE_DIR=./model_cache
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-your-server-side-api-key
LLM_MODEL=deepseek-flash
LLM_THINKING_MODE=default
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200
# Legacy LLM_* generation controls above apply only to older script entry points.
# Stage4 chat always selects an explicit immutable profile per request/purpose.
AGENT_PLAIN_TOKENS=2048
AGENT_PLAIN_TIMEOUT=90
AGENT_THINKING_TOKENS=8192
AGENT_THINKING_TIMEOUT=180
AGENT_THINKING_EFFORT=high
TRANSCRIPTION_TOKENS=4096
TRANSCRIPTION_TIMEOUT=90
CITATION_CHECK_TOKENS=1024
CITATION_CHECK_TIMEOUT=60
RETRIEVAL_TIMEOUT=45
CHAT_DEADLINE_SECONDS=360
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=30
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_DISTANCE=0.65
RETRIEVAL_MAX_CHARS=12000
RETRIEVAL_STRATEGY=dense
# Optional follow-up experiments; keep false for existing defaults.
RETRIEVAL_QUERY_NORMALIZATION=false
RETRIEVAL_FACET_COVERAGE=false
RETRIEVAL_SECTION_BACKFILL=false
RETRIEVAL_GROUNDED_ANSWERS=false
RETRIEVAL_TABLE_REASONING=false
RETRIEVAL_STRUCTURED_CANDIDATES=false
RETRIEVAL_FACET_CONTEXT=false
# Opt-in exact table-row/FK verification. Requires caption/header/DDL-preserving
# chunks; never reprocesses existing material. Program answers identify their
# method in SSE done; ordinary prose continues through the configured LLM.
RETRIEVAL_VERIFIED_TABLES=false
RETRIEVAL_TABLE_SCAN_CHUNKS=300
RETRIEVAL_TABLE_SCAN_CHARS=200000
RETRIEVAL_TABLE_MAX_HOPS=3
RETRIEVAL_TABLE_MAX_ROWS=40
RETRIEVAL_TABLE_MAX_SOURCES=16
RETRIEVAL_CANDIDATES=30
RETRIEVAL_RERANK_CANDIDATES=20
RETRIEVAL_RRF_K=60
RETRIEVAL_KEYWORD_MIN_SCORE=1.0
RETRIEVAL_RERANK_MIN_SCORE=0.0
RETRIEVAL_LEXICAL_MAX_CHUNKS=10000
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANKER_LOCAL_FILES_ONLY=true
RETRIEVAL_RERANK_GATE=legacy
RETRIEVAL_RERANK_STRONG_SCORE=0
RETRIEVAL_RERANK_SUPPORT_DISTANCE=0.3
RETRIEVAL_RERANK_SUPPORT_KEYWORD=3
RETRIEVAL_DEDUPLICATE=true
RERANKER_THREADS=2
RERANKER_BATCH_SIZE=4
RERANKER_LENGTH_BUCKETING=true
RERANKER_PASSAGE_CHARS=0
RERANK_SCORE_CACHE=false
RERANK_CACHE_ENTRIES=2048
RERANK_CACHE_TTL_SECONDS=600
RETRIEVAL_PAIR_HEADINGS=false
RETRIEVAL_EXPAND_TERMS=false
RETRIEVAL_BALANCED_CANDIDATES=false
RETRIEVAL_DIVERSIFY=false
RETRIEVAL_SECTION_LIMIT=2


# Stage 4: basic agent termination and context compatibility (not quotas)
AGENT_MAX_ROUNDS=4
AGENT_HISTORY_MESSAGES=12
AGENT_HISTORY_CHARS=18000

# Stage 5 external tools (server only). Fill your Tavily key below.
# Chat chooses configured tools automatically; omit legacy manual authorization fields.
# GitHub credentials are scoped by account UUID and lowercase repository; Contents read only.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
EXTERNAL_TIMEOUT=20
GITHUB_CREDENTIALS={}

# Stage 6 full local deployment: docker compose -p studyrag-local --profile app up
WEB_PORT=8080
# API/Worker receive container database, Redis and volume paths automatically.
# For a custom env file, also set APP_ENV_FILE to that same file when invoking Compose.
# Optional trusted base-image overrides for environments unable to reach Docker Hub:
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.13-slim
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
# NGINX_IMAGE=public.ecr.aws/docker/library/nginx:stable-alpine

# Opt-in context experiments: new uploads only; no automatic reindex.
INGESTION_AGGREGATE_SHORT=false
RETRIEVAL_ADJACENT_CONTEXT=false

# Opt-in context/finalization policies; retain false until project-specific review.
# Context units are UTF-8-byte estimates plus overhead, NOT exact vendor tokens.
CONTEXT_BUDGET_ENABLED=false
CONTEXT_REQUEST_TOKENS=65536
CONTEXT_MARGIN_TOKENS=1024
CONTEXT_TURN_TOKENS=1048576
CONTEXT_TURN_CALLS=16
# Omit CONTEXT_IMAGE_TOKENS until an operator has a defensible visual estimate.
AGENT_FINALIZE_ENABLED=false
AGENT_FINALIZE_TIMEOUT=25
AGENT_REVIEW_RESERVE_SECONDS=90
